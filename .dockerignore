# Build-context exclusions for both the API and frontend Dockerfile stages.

# ---- VCS, tooling, editor ----
.git
.github
.gitignore
.dockerignore
.claude
.pytest_cache
.DS_Store
**/.DS_Store
**/__pycache__
**/*.py[cod]

# ---- Virtualenvs (Linux images cannot use a macOS venv) ----
venv/
.venv/
env/

# ---- Node ----
# node_modules is reinstalled by `npm ci`; a host copy may be the wrong platform.
frontend/node_modules/
frontend/dist/

# frontend/.env: gitignored but on every dev machine; `vite build` reads it and would bake in a stale localhost URL.
frontend/.env
frontend/.env.*

# ---- Artefacts the build regenerates; excluding them keeps every build like a clean checkout ----
outputs/
data/cache/

# ---- Not needed by any image ----
tests/
docs/
README.md
ace-startup-guide.md
render.yaml
docker-compose.yml
Dockerfile
