# Copy to .env (gitignored) and adjust. Vite only exposes VITE_-prefixed vars.
#
# Base URL of the ace API — no trailing slash required, the client strips one.
# Nothing in src/ hardcodes a fallback: if this is unset, the client throws an
# ApiConfigError naming this file rather than guessing an origin.
#
# Serve the API with:
#   PYTHONPATH=src uvicorn api.main:app --reload
#
# The origin you point at must also be in config.API_ALLOWED_ORIGINS on the API
# side (CORS is an explicit allow-list, never "*"); localhost:5173 and
# 127.0.0.1:5173 — the Vite dev server, both spellings — are allowed already.
VITE_API_BASE_URL=http://localhost:8000
